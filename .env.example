POSTGRES_DB=customer_support
POSTGRES_USER=customer_support
POSTGRES_PASSWORD=customer_support

DB_URL=jdbc:postgresql://localhost:5432/customer_support
DB_USERNAME=customer_support
DB_PASSWORD=customer_support
SERVER_PORT=8080

AGENT_ENABLED=true

# OpenAI models
OPENAI_API_KEY=
OPEN_AI_MODEL=gpt-5.4-nano
OPEN_AI_EMBEDDING_MODEL=text-embedding-3-small

# Retrieval-Augmented Generation
RAG_ENABLED=true
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.60
